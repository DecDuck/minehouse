{
  "name": "minehouse-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate:openapi": "cd ../server && OPENAPI_OUTPUT=../frontend/openapi.yaml OASGEN_WRITE_SPEC=1 cargo run",
    "generate:api": "pnpm generate:openapi && openapi-typescript openapi.yaml -o app/api-types.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "nuxt": "^4.5.2",
    "openapi-fetch": "^0.13.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0"
  }
}
